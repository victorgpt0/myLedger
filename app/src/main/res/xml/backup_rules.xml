<?xml version="1.0" encoding="utf-8"?>
<!--
    API 23–30 backup rules. Nothing is backed up: the database holds M-PESA message text, and
    the app promises SMS-derived data never leaves the device. Everything can be rebuilt from
    the SMS inbox by re-importing, so nothing is lost by excluding it.
    (allowBackup="false" already disables this; the explicit excludes are a second guard.)
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
